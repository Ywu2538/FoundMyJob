# Local single-user only. Copy to .env.local to enable YOUR machine's Cursor.
# GitHub source has Cursor disabled by default; no keys belong in this file.
FMJ_DEPLOYMENT=local
FMJ_ALLOW_CURSOR=0
PORT=4173

# Optional FOB self-hosted model. Leave blank until your model service is ready.
# Set these on the FOB backend; never put a real service key in this tracked example.
# The base URL should include /v1 when required by your model server.
FMJ_SELF_HOSTED_BASE_URL=
FMJ_SELF_HOSTED_MODEL=
FMJ_SELF_HOSTED_API_KEY=
FMJ_SELF_HOSTED_TIMEOUT_MS=180000
FMJ_SELF_HOSTED_MAX_TOKENS=6000
